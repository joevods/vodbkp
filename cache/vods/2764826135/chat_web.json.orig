iny-2-final-shape-raid-race","v":"1"}],"u":{"n":"JellyChannelTTV","c":"#DAA520"},"f":[{"t":"mmhm! its very tricky"}],"t":8968.285},{"b":[],"u":{"n":"primaryfire","c":"#FF0000"},"f":[{"t":"low attacks are pretty infrequent so dodging down is generally safer than parrying , but they are very fast and hard to react to if you aren't looking for them specifically"}],"t":8978.307},{"b":[],"u":{"n":"shipgosync","c":"#FF69B4"},"f":[{"t":"Flashkicks took the longest to learn for me and they still fuck me up sometimes for sure"}],"t":8984.212},{"b":[],"u":{"n":"duskwaterdrm","c":"#8CC516"},"f":[{"t":"yeah but the low kick isnt part of a combo"}],"t":8984.371},{"b":[{"id":"subscriber","v":"0"}],"u":{"n":"Luke353777","c":"#1A127F"},"f":[{"t":"You can only really get it through repetition and seeing it tbh"}],"t":8985.65},{"b":[{"id":"subscriber","v":"6"},{"id":"superultracombo-2023","v":"1"}],"u":{"n":"thebalticguy1","c":"#E7CA95"},"f":[{"t":"@andersonjph part of this is a nomenclature issue with chat, Souls has Parry and dodge, where here we have Deflect/Parry/Avoid/Dodge easy to confuse"}],"t":8986.338},{"b":[{"id":"","v":""},{"id":"cryana","v":"1"}],"u":{"n":"coke_monster","c":"#FF0000"},"f":[{"t":"I avoid those attacks by not playing the game"}],"t":8990.552},{"b":[{"id":"moderator","v":"1"},{"id":"","v":""},{"id":"destiny-2-final-shape-raid-race","v":"1"}],"u":{"n":"JellyChannelTTV","c":"#DAA520"},"f":[{"t":"dodging lows is the biggest hurdle to getting better, its very difficult"}],"t":8991.705},{"b":[{"id":"","v":""},{"id":"bits","v":"100"}],"u":{"n":"LordFifth_ISSTH","c":"#8A2BE2"},"f":[{"t":"Most atacks are high or medium, so avoid down works, and low atacks are very punishable once you learn them"}],"t":8992.129},{"b":[{"id":"subscriber","v":"6"},{"id":"share-the-love","v":"1"}],"u":{"n":"AmanS17","c":"#FF4500"},"f":[{"t":"@JellyChannelTTV true, this game did get nominated for best fighting game"}],"t":8995.253},{"b":[{"id":"cdawg-cyclethon-5-badge","v":"1"}],"u":{"n"